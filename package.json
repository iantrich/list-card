{
  "name": "list-card",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:dev": "rollup -c rollup.config.dev.js",
    "start": "rollup -c rollup.config.dev.js --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
